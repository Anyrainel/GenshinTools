{
  "name": "genshintools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "node scripts/dev/start-worker-dev.js",
    "dev:worker": "node scripts/dev/start-worker-dev.js",
    "dev:worker:reset": "node scripts/dev/start-worker-dev.js --reset-backup-db",
    "dev:e2e": "node scripts/dev/start-e2e-server.js",
    "deploy:worker": "npm run check:worker && wrangler deploy",
    "build": "npm run check:app && npm run check:worker:cheap && npm run test:worker && npm run build:app && npm run check:worker-build && npm run cf:dry-run",
    "postbuild": "node scripts/dev/apply-cloudflare-migrations.js",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "cf:types": "wrangler types worker-configuration.d.ts && node scripts/dev/normalize-worker-types.mjs",
    "cf:types:check": "wrangler types worker-configuration.d.ts --check",
    "cf:dry-run": "node scripts/dev/run-worker-dry-run.js",
    "check:worker-config": "node scripts/dev/check-worker-config.js",
    "check:worker-build": "node scripts/dev/check-worker-build-output.js",
    "check:worker-safety": "node scripts/dev/check-worker-safety.js",
    "check:worker:cheap": "npm run check:worker-config && npm run check:worker-safety && npm run cf:types:check && npm run test:deploy-migrations",
    "test:deploy-migrations": "node --test tests/scripts/cloudflareMigrations.test.mjs",
    "check:worker": "npm run check:worker:cheap && npm run build:app && npm run check:worker-build && npm run test:worker && npm run cf:dry-run",
    "feedback:fetch": "node scripts/dev/fetch-feedback-report.js",
    "data:refresh": "uv run --project scripts python scripts/refresh_game_data.py",
    "data:scanner:check": "node scripts/check-scanner-data.mjs",
    "type-check": "npm run cf:types:check && tsc -b --noEmit",
    "test": "vitest run",
    "styles:generate": "node scripts/generate-game-palette.mjs",
    "styles:check": "node scripts/generate-game-palette.mjs --check",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "smoke:backup-worker": "node scripts/dev/check-backup-smoke-token.js && npm run build && node scripts/dev/smoke-backup-worker.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test -c playwright.public.config.ts",
    "test:e2e:account": "playwright test e2e/account-backup.spec.ts --project=desktop",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "qa:dmg": "tsx --tsconfig tsconfig.scripts.json scripts/qa-dmg.ts",
    "benchmark": "tsx --tsconfig tsconfig.app.json tests/benchmark/benchmark.ts",
    "regtest": "tsx --tsconfig tsconfig.app.json tests/regression/regression.ts",
    "depcheck": "depcruise src tests worker --config .dependency-cruiser.cjs",
    "check:boss-icons": "node scripts/dev/check-leyline-boss-icons.js",
    "check:artifact-set-roles": "tsx --tsconfig tsconfig.scripts.json scripts/dev/check-artifact-set-roles.ts",
    "check:calculator-readiness": "vitest run tests/domain/combat/damage/entityReadiness.test.ts",
    "check:hoyolab": "node scripts/dev/check-hoyolab-version.js",
    "check:hoyolab:fix": "node scripts/dev/check-hoyolab-version.js --fix",
    "// --- Safe / Piped Variants (Agent Helpers) ---": "",
    "type-check:filter": "node scripts/dev/run-filter.js type-check",
    "type-check:head": "node scripts/dev/run-head.js type-check",
    "lint:filter": "node scripts/dev/run-filter.js lint",
    "lint:head": "node scripts/dev/run-head.js lint",
    "test:filter": "node scripts/dev/run-filter.js test",
    "test:head": "node scripts/dev/run-head.js test",
    "type-check:tail": "node scripts/dev/run-tail.js type-check",
    "lint:tail": "node scripts/dev/run-tail.js lint",
    "test:tail": "node scripts/dev/run-tail.js test",
    "type-check:headtail": "node scripts/dev/run-headtail.js type-check",
    "lint:headtail": "node scripts/dev/run-headtail.js lint",
    "test:headtail": "node scripts/dev/run-headtail.js test",
    "build:app": "npm run data:scanner:check && tsc -b && vite build",
    "test:dependency-rules": "node --test scripts/dependency-rules.test.mjs",
    "check:app": "npm run styles:check && npm run lint && npm run type-check && npm run depcheck && npm run test:tooling && npm test && npm run regtest -- run --quiet && npm run check:boss-icons && npm run check:artifact-set-roles && npm run data:scanner:check",
    "check": "npm run check:app && npm run check:worker && npm run check:python",
    "test:tooling": "node --test scripts/dependency-rules.test.mjs scripts/related-tests.test.mjs scripts/architecture-layout.test.mjs",
    "check:python": "uv run --project scripts ty check scripts && uv run --project scripts python -m unittest discover -s scripts/tests"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "scripts/**/*.py": [
      "uvx ruff format",
      "uvx ruff check --fix"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@logto/react": "4.1.0",
    "@tanstack/react-virtual": "3.14.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-to-image": "1.11.13",
    "immer": "11.1.21",
    "jose": "6.2.12",
    "lucide-react": "1.55.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@babel/types": "8.0.6",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@msw/cloudflare": "0.2.0",
    "@playwright/test": "1.64.0",
    "@swc/core": "1.16.18",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.6.0",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "jsonc-parser": "3.3.1",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
