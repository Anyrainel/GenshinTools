{
  "name": "genshintools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "wrangler pages dev --proxy 5173 -- vite",
    "build": "tsc -b && vite build",
    "build:tauri": "tsc -b && vite build --mode tauri",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc -b --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run && npm run regtest -- run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "tauri": "tauri",
    "qa:dmg": "tsx --tsconfig tsconfig.scripts.json scripts/qa-dmg.ts",
    "benchmark": "tsx --tsconfig tsconfig.test.json tests/benchmark/benchmark.ts",
    "regtest": "tsx --tsconfig tsconfig.test.json tests/regression/generator-bench.ts",
    "// --- Safe / Piped Variants (Agent Helpers) ---": "",
    "type-check:filter": "node scripts/dev/run-filter.js type-check",
    "type-check:head": "node scripts/dev/run-head.js type-check",
    "lint:filter": "node scripts/dev/run-filter.js lint",
    "lint:head": "node scripts/dev/run-head.js lint",
    "test:filter": "node scripts/dev/run-filter.js test",
    "test:head": "node scripts/dev/run-head.js test",
    "type-check:tail": "node scripts/dev/run-tail.js type-check",
    "lint:tail": "node scripts/dev/run-tail.js lint",
    "test:tail": "node scripts/dev/run-tail.js test",
    "type-check:headtail": "node scripts/dev/run-headtail.js type-check",
    "lint:headtail": "node scripts/dev/run-headtail.js lint",
    "test:headtail": "node scripts/dev/run-headtail.js test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "scripts/**/*.py": ["uvx ruff format", "uvx ruff check --fix"]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "immer": "^11.0.1",
    "lucide-react": "^0.556.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20260129.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.9.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15",
    "wrangler": "^4.61.1"
  }
}
