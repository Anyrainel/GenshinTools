#!/usr/bin/env sh

# Per-file lint & format (Biome for TS, Ruff for Python)
npx lint-staged --no-stash

# Run tests related to staged TS/TSX files, plus global convention guards
# Skip for merge commits — individual commits were already tested
if [ ! -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
  if [ -n "$STAGED_TS_FILES" ]; then
    echo "Running related tests..."
    npx vitest related --run $STAGED_TS_FILES || exit 1

    echo "Running dependency-cruiser..."
    npm run depcheck || exit 1
  fi

  WORKER_CHECK_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(worker/|wrangler\.jsonc|vite\.config\.ts|vitest\.worker\.config\.ts|tsconfig\.worker(-tests)?\.json|worker-configuration\.d\.ts|scripts/dev/(check-worker-|run-worker-dry-run)|package(-lock)?\.json$)' || true)
  if [ -n "$WORKER_CHECK_FILES" ]; then
    echo "Running cheap Worker checks..."
    npm run check:worker:cheap || exit 1
  fi

  echo "Running file convention and i18n tests..."
  npx vitest run tests/fileConventions.test.ts tests/i18n.test.ts || exit 1
fi
