#!/usr/bin/env sh
# Per-file lint & format (Biome for TS, Ruff for Python)
npx lint-staged

# Project-level checks for TypeScript
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS_FILES" ]; then
  echo "Running TypeScript type check..."
  npm run type-check || exit 1

  echo "Running tests..."
  npm run test || exit 1
fi

# Project-level checks for Python
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'scripts/.*\.py$' || true)
if [ -n "$STAGED_PY_FILES" ]; then
  echo "Running ty check..."
  cd scripts || exit 1
  uv run ty check . || exit 1
  cd .. || exit 1
fi
