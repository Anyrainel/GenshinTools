#!/usr/bin/env sh
has_updates=false
validated_head=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  has_updates=true
  if [ -z "$validated_head" ]; then
    validated_head=$(git rev-parse --verify HEAD) || exit 1
  fi
  if [ "$local_sha" != "$validated_head" ]; then
    echo "Push blocked: $local_ref is not the checked-out HEAD."
    exit 1
  fi
done
if [ "$has_updates" = false ]; then exit 0; fi
require_clean_head() {
  current_head=$(git rev-parse --verify HEAD) || return 1
  checkout_status=$(git status --porcelain --untracked-files=normal) || return 1
  if [ "$current_head" != "$validated_head" ] || [ -n "$checkout_status" ]; then
    echo "Push blocked: commit or remove pending changes before validating the pushed HEAD."
    return 1
  fi
}
require_clean_head || exit 1
git diff --check || exit 1
echo "Validating the complete application and Worker before push..."
npm run check || exit 1
npm run check:hoyolab || exit 1
require_clean_head || exit 1
