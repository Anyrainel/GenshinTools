* text=auto eol=lf

# Explicitly keep Windows scripts as CRLF
*.{cmd,bat,ps1} text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Gzipped beta game data — marked binary so GitHub excludes from code search
# and diff views. These files are auto-generated by scripts/lunaris.py.
*.json.gz binary
*.json.gz linguist-generated
