{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "off",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "error",
        "useNodejsImportProtocol": "error",
        "noUselessElse": "error",
        "useShorthandAssign": "warn"
      },
      "complexity": {
        "noForEach": "warn",
        "noExcessiveCognitiveComplexity": "off",
        "useSimplifiedLogicExpression": "off",
        "useFlatMap": "warn",
        "noUselessFragments": "error",
        "noUselessTernary": "error",
        "noUselessCatch": "error",
        "noUselessStringConcat": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessUndefinedInitialization": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noApproximativeNumericConstant": "off",
        "noUnknownAtRules": "off",
        "noEmptyBlockStatements": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "lineEnding": "lf",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/public",
      "!**/scripts",
      "!**/*.min.js",
      "!**/*.d.ts",
      "!**/src/components/ui",
      "!**/src/generated/translations/i18n-game.ts",
      "!**/src/generated/translations/i18n-beta.ts",
      "!**/src/generated/catalog/resources.ts",
      "!**/src/generated/catalog/resources_beta.ts",
      "!**/src/generated/catalog/enkaIdMap.ts",
      "!**/src/generated/**/*.json",
      "!**/src/generated/catalog/characterInfo.ts",
      "!**/tests/**/__golden__",
      "!**/tests/**/data"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["**/tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "off"
          }
        }
      }
    },
    {
      "includes": ["src/domain/combat/damage/impl/**"],
      "linter": {
        "enabled": true,
        "rules": {
          "preset": "recommended",
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off",
            "noUnusedPrivateClassMembers": "off"
          }
        }
      }
    }
  ]
}
