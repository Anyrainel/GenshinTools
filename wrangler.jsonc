{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ggartifact",
  "compatibility_date": "2026-04-30",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "LOGTO_ENDPOINT": "https://synz8r.logto.app",
    "LOGTO_APP_ID": "tglrsenlbfrfrnevjwlan"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Cloudflare's React + Vite template uses "single-page-application" here.
    // This app routes SPA fallbacks in worker/index.ts instead, so missing
    // hashed chunks and public assets return real 404s instead of index.html.
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "BACKUP_DB",
      "database_name": "ggartifact-backup",
      "database_id": "5227b90e-8057-4068-8ec1-b498458075f4"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "ggartifact-backup",
      "binding": "BACKUP_BUCKET"
    }
  ],
  "env": {
    "dev": {
      "vars": {
        "LOGTO_ENDPOINT": "https://synz8r.logto.app",
        "LOGTO_APP_ID": "tglrsenlbfrfrnevjwlan"
      },
      "d1_databases": [
        {
          "binding": "BACKUP_DB",
          "database_name": "ggartifact-backup",
          "database_id": "5227b90e-8057-4068-8ec1-b498458075f4"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "ggartifact-backup",
          "binding": "BACKUP_BUCKET"
        }
      ]
    }
  }
}
