{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ggartifact",
  "compatibility_date": "2026-04-30",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
