# === DEFAULT: no-cache for HTML / SPA routes ===
# Catch-all must come first. More-specific rules below override it for
# static assets. This ensures SPA-rewritten paths (/optimizer, /team-comp,
# etc.) that serve index.html content get proper no-cache headers — the
# old /index.html-only rule didn't cover rewritten paths.
/*
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff

# === HASHED BUILD ASSETS (Vite output) ===
# Filename contains content hash — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# === STATIC GAME DATA (images, icons) ===
# Unhashed but rarely change. 30-day browser cache + 1-day SWR.
# CDN cache same duration; purge after asset updates if needed.
/artifact/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

