# Matching rules ADD headers; later rules do not override earlier rules.
# Keep cache policies out of this catch-all so assets can use browser caching.
/*
  X-Content-Type-Options: nosniff

# The Worker sets these same headers on every SPA route, including deep links.
/
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

# === HASHED BUILD ASSETS (Vite output) ===
# Do not match public images in /assets/ with the immutable build policy.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

# === STATIC GAME DATA (images, icons) ===
# Unhashed but rarely change. 30-day browser cache + 1-day SWR.
# CDN cache same duration; purge after asset updates if needed.
/artifact/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/character/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/element/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/enemy/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/food/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/weapon/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/weapontype/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/assets/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/assets/*.JPG
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

# Brand assets have stable, unhashed URLs; revalidate after a release.
/logo-*.svg
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

/favicon.svg
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

# === GOOD DATA (CORS-enabled exports) ===
/good/*
  Access-Control-Allow-Origin: *

/good/mapping_achievements.json
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=604800

/good/README.md
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=604800

# Shared non-achievement reference for OCR, capture and manager.
/good/genshin_scanner_data.json
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store
